# Venly API Configuration
# Get these from https://portal.venly.io/
VENLY_CLIENT_ID=your-client-id-here
VENLY_CLIENT_SECRET=your-client-secret-here

# Environment: sandbox or production
# ALWAYS START WITH SANDBOX FOR TESTING
VENLY_ENVIRONMENT=sandbox

# Treasury Wallet ID
# Create a wallet in Venly first, then add its ID here
TREASURY_WALLET_ID=your-wallet-uuid-here

# Server Configuration
PORT=3000

# Safe Mode Settings (Production Safety)
# Maximum transaction amount in USD
SAFE_MODE_MAX_AMOUNT=1000
# Warning threshold for large transactions
SAFE_MODE_WARNING_THRESHOLD=500

# Audit Logging
AUDIT_LOG_ENABLED=true
# Options: sheets, notion, local
AUDIT_PROVIDER=local
# For local provider: directory to store logs
AUDIT_LOG_DIR=./audit-logs

# Google Sheets Audit (Optional)
# Paste entire service account JSON as string
# GOOGLE_SHEETS_CREDS={"type":"service_account",...}

# Notion Audit (Optional)
# NOTION_CREDS={"databaseId":"xxx","token":"secret_xxx"}

# Slack Alerts (Optional)
# SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# ALERT_EMAIL=admin@company.com
